#!/usr/bin/env bash
#MISE description="Clone and build yzane/vscode-markdown-pdf for the mdpdf CLI wrapper (rerun to update)"

set -euo pipefail

REPO_DIR="${MARKDOWN_PDF_EXT_ROOT:-$HOME/.cache/markdown-pdf-cli/vscode-markdown-pdf}"

if ! command -v node &>/dev/null; then
    echo "Error: node is not installed" >&2
    exit 1
fi

if [ -d "${REPO_DIR}/.git" ]; then
    echo "Updating ${REPO_DIR}..."
    git -C "${REPO_DIR}" pull --ff-only
else
    mkdir -p "$(dirname "${REPO_DIR}")"
    git clone --depth 1 https://github.com/yzane/vscode-markdown-pdf.git "${REPO_DIR}"
fi

cd "${REPO_DIR}"
npm ci --no-audit --no-fund
npm run build

echo "Built: ${REPO_DIR}/dist/extension.js"
echo "Usage: mdpdf [--type pdf|html|png|jpeg|all] [-s settings.json] [-o outdir] <file.md>..."
