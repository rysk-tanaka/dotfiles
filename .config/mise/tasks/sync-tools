#!/usr/bin/env bash
#MISE description="Sync mise tools after Renovate pull: install, prune unused versions, check Codex health"
#USAGE flag "--yes" help="Skip prune confirmation prompt"

set -euo pipefail

DOTFILES_PATH="${DOTFILES_PATH:-$(cd "$(dirname "$0")/../../.." && pwd)}"

# 1. install new pinned versions (Renovate が更新した config.toml を反映)
echo "==> Installing tools (mise install)..."
cd "$DOTFILES_PATH"
mise install

# 2. prune unused versions (confirm)
echo ""
echo "==> Prunable versions:"
# mise prune は全 tracked-configs 横断のグローバル操作（登録済み全リポジトリで未使用のものを削除）
prunable=$(mise ls --prunable 2>/dev/null || true)
# Only set when prune ran, so post-prune notices are not shown on skip.
# It holds the pre-prune list; a version reused meanwhile is kept by mise prune and only
# yields a harmless extra notice, since the suggested venv re-creation is idempotent.
pruned=""
if [ -z "$prunable" ]; then
    echo "  (none)"
else
    echo "$prunable" | sed 's/^/  /'
    echo ""
    echo "Note: mise prune は登録済み全リポジトリで未使用のバージョンを削除します（グローバル操作）"
    if [ "${usage_yes:-false}" = "true" ]; then
        answer="y"
    else
        printf "削除しますか？ [y/N]: "
        read -r answer || answer=""
    fi
    case "$answer" in
        [yY])
            pruned="$prunable"
            # 途中で失敗しても一部は削除済みのため、set -e で止めずに後続の正規化と注意表示まで進める
            if ! mise prune -y; then
                echo "  ⚠ mise prune failed partway — some versions may already be removed"
            fi
            ;;
        *) echo "スキップしました" ;;
    esac
fi

# 3. normalize gh credential helper (version-pinned path → PATH-resolved)
# gh auth setup-git は gh の絶対パス（バージョン固定）を helper に焼き込むため、
# 上の prune で旧バージョンが消えると helper が壊れる。PATH 解決形に書き換えて再発を防ぐ。
echo ""
echo "==> Normalizing gh credential helpers..."
broken_keys=$(git config --global --get-regexp 'credential\..*\.helper' 2>/dev/null \
    | awk '/aqua-cli-cli\/[0-9]/ {print $1}' | sort -u || true)
if [ -z "$broken_keys" ]; then
    echo "  ✓ no version-pinned paths"
else
    while IFS= read -r key; do
        git config --global --replace-all "$key" '!gh auth git-credential' 'aqua-cli-cli/[0-9]'
        echo "  fixed: $key"
    done <<< "$broken_keys"
fi

# 4. post-prune notices
# venv は python 実体への symlink を持つため、旧版を prune すると旧版で作った .venv や uv tool の環境が壊れる。
# 環境はリポジトリごとに散在し外部から一括で直せないため、再作成を促す。
# starship は .zshrc で init スクリプトの絶対パスを PATH 解決形に書き換えているため対象外。
if [ -n "$pruned" ]; then
    echo ""
    echo "==> Post-prune notices:"
    # prune は全 tracked-configs 横断なので、他リポジトリのバックエンド付き表記（core:python 等）も拾う
    if grep -qE '^([a-z-]+:)?python[[:space:]]' <<< "$pruned"; then
        echo "  ⚠ python の旧版を削除しました — 旧版で作成した .venv や uv tool の環境は再作成が必要です（uv sync / uv tool install --reinstall 等）"
    else
        echo "  ✓ no action needed"
    fi
fi

# 5. Codex health checks (best-effort, non-fatal)
echo ""
echo "==> Codex health:"
if ! command -v codex &>/dev/null; then
    echo "  - skipped (codex not installed)"
    exit 0
fi

# 5a. CLI version lag (brew のキャッシュ状態を参照)
if command -v brew &>/dev/null; then
    if brew outdated --cask codex 2>/dev/null | grep -q '^codex'; then
        echo "  ⚠ codex is outdated — run: brew upgrade --cask codex"
    else
        echo "  ✓ codex up to date ($(codex --version 2>/dev/null))"
    fi
else
    echo "  - version check skipped (brew not available)"
fi

# 5b. configured model がカタログに在るか（撤去検知）
# config.toml を tomllib でパースして top-level model を取得（Python 3.11+ stdlib、引用符の差異を正しく処理）
conf_model=$(python3 -c "import tomllib,sys; print(tomllib.load(open(sys.argv[1],'rb')).get('model',''))" "${DOTFILES_PATH}/.codex/config.toml" 2>/dev/null || true)
if [ -z "$conf_model" ]; then
    echo "  - model check skipped (config に model 指定なし)"
    exit 0
fi

# codex debug models をリポジトリ内で実行すると config.toml に trust ブロックが追記される副作用があるため、
# git リポジトリ外の一時ディレクトリから実行する
# （~/.codex/config.toml は repo からコピーした実ファイル。repo 側と model 設定が一致している前提でカタログ照合する）
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
if catalog=$(cd "$tmp" && codex debug models 2>/dev/null) && [ -n "$catalog" ]; then
    # codex が非 JSON を exit 0 で返すケースを「撤去」と誤判定しないよう、解析失敗(2)を分離する
    py_exit=0
    printf '%s' "$catalog" | python3 -c "
import sys, json
try:
    slug = sys.argv[1]
    d = json.load(sys.stdin)
    sys.exit(0 if any(m.get('slug') == slug for m in d.get('models', [])) else 1)
except (json.JSONDecodeError, ValueError):
    sys.exit(2)
" "$conf_model" 2>/dev/null || py_exit=$?
    case $py_exit in
        0) echo "  ✓ configured model '$conf_model' is available" ;;
        1) echo "  ⚠ configured model '$conf_model' not in catalog — 撤去された可能性。config.toml の model を見直してください" ;;
        *) echo "  - model check skipped (カタログ形式を解析できませんでした)" ;;
    esac
else
    echo "  - model check skipped (codex auth/network unavailable)"
fi
